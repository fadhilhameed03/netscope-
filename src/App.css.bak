:root {
  color-scheme: dark;
}

body {
  margin: 0;
  background: #0a0e14;
}

.app-title {
  color: #3fae7a;
  margin-top: 0;
  margin-bottom: 20px;
  font-size: 28px;
  letter-spacing: 0.5px;
}

/* --- Scan form --- */

.scan-form-row {
  display: flex;
  gap: 12px;
  margin-bottom: 10px;
  flex-wrap: wrap;
}

.target-input {
  padding: 10px 12px;
  flex: 1;
  min-width: 240px;
  background: #141a14;
  color: #fff;
  border: 1px solid #2e7d5b;
  border-radius: 4px;
  font-size: 14px;
}

.profile-select {
  padding: 10px 12px;
  background-color: #141a14 !important;
  color: #fff !important;
  border: 1px solid #2e7d5b !important;
  border-radius: 4px;
  font-size: 14px;
  min-width: 220px;
}

.profile-select option {
  background-color: #141a14;
  color: #fff;
  padding: 8px;
}

.scan-btn {
  padding: 10px 28px;
  background: #2e7d5b;
  color: #fff;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
}

.scan-btn:hover:not(:disabled) {
  background: #3fae7a;
}

.scan-btn:disabled {
  opacity: 0.6;
  cursor: default;
}

.error-banner {
  color: #ff6b6b;
  margin: 16px 0;
  padding: 10px 14px;
  background: rgba(255, 107, 107, 0.08);
  border: 1px solid #8b2f2f;
  border-radius: 4px;
}

/* --- Zenmap-style editable command bar --- */

.command-row {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #0d1310;
  border: 1px solid #2e7d5b;
  border-radius: 4px;
  padding: 10px 14px;
  margin-bottom: 20px;
  font-family: "Courier New", Courier, monospace;
  font-size: 13px;
}

.command-label {
  color: #7fbf9f;
  flex-shrink: 0;
}

.command-fixed {
  color: #3fae7a;
  flex-shrink: 0;
}

.command-input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: #e0e0e0;
  font-family: inherit;
  font-size: 13px;
}

/* --- Main layout: graph+log on left, wider sidebar on right, details spans full width below --- */

.main-grid {
  display: grid;
  grid-template-columns: 1fr 420px;
  grid-template-rows: auto auto;
  gap: 20px;
  align-items: start;
  margin-top: 16px;
}

.sidebar-col {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.side-panel {
  background: #0d1310;
  border: 1px solid #2e7d5b;
  border-radius: 8px;
  padding: 18px;
}

.panel-heading {
  margin: 0 0 12px 0;
  color: #3fae7a;
  font-size: 15px;
}

.action-row {
  display: flex;
  gap: 8px;
  margin-bottom: 10px;
}

.export-btn {
  flex: 1;
  padding: 8px 10px;
  background: #141a14;
  color: #3fae7a;
  border: 1px solid #2e7d5b;
  border-radius: 4px;
  cursor: pointer;
  font-size: 12.5px;
  font-family: inherit;
  transition: background 0.15s ease;
}

.export-btn:hover:not(:disabled) {
  background: #1e2a1e;
  color: #7fffb0;
}

.export-btn:disabled {
  opacity: 0.6;
  cursor: default;
}

.vuln-btn {
  width: 100%;
  margin-bottom: 12px;
  color: #ff9d5c;
  border-color: #a35a2e;
  padding: 10px;
}

.vuln-log-panel {
  margin-bottom: 12px;
}

.host-list {
  max-height: 320px;
  overflow-y: auto;
}

.host-row {
  padding: 10px;
  border-bottom: 1px solid #1e2a1e;
  cursor: pointer;
  border-left: 3px solid transparent;
  font-size: 13.5px;
}

.host-row:hover {
  background: #141a14;
}

.host-row-active {
  background: #141a14;
  border-left: 3px solid #3fae7a;
}

.host-row-sub {
  font-size: 12px;
  color: #7fbf9f;
  margin-top: 2px;
}

/* --- Full-width host details panel (spans both grid columns) --- */

.details-panel {
  grid-column: 1 / -1;
  background: #0d1310;
  border: 1px solid #2e7d5b;
  border-radius: 8px;
  padding: 24px;
}

.details-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 20px;
  margin-bottom: 20px;
  padding-bottom: 16px;
  border-bottom: 1px solid #1e2a1e;
}

.details-ip {
  color: #3fae7a;
  margin: 0;
  font-size: 22px;
}

.details-hostname {
  color: #9fbfae;
  margin: 4px 0 0 0;
  font-size: 14px;
}

.details-meta {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 13.5px;
  color: #cfe;
  text-align: right;
}

.meta-label {
  color: #7fbf9f;
  margin-right: 6px;
}

.ports-heading {
  color: #3fae7a;
  margin-bottom: 14px;
  font-size: 16px;
}

.port-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  gap: 12px;
}

.port-card {
  background: #141a14;
  border: 1px solid #1e2a1e;
  border-radius: 6px;
  padding: 12px 14px;
}

.port-card-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 4px;
}

.port-number {
  color: #3fae7a;
  font-family: "Courier New", Courier, monospace;
  font-weight: 700;
  font-size: 14px;
}

.port-service {
  color: #e0e0e0;
  font-size: 13px;
}

.port-version {
  color: #9fbfae;
  font-size: 12.5px;
  margin-bottom: 8px;
  word-break: break-word;
}

.port-cves {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

/* --- CVE severity badges --- */

.cve-badge {
  display: inline-block;
  padding: 3px 7px;
  border-radius: 3px;
  font-size: 11px;
  font-family: "Courier New", Courier, monospace;
  cursor: help;
}

.cve-badge-high {
  background: rgba(255, 90, 90, 0.15);
  color: #ff6b6b;
  border: 1px solid #8b2f2f;
}

.cve-badge-medium {
  background: rgba(255, 180, 90, 0.15);
  color: #ffb45a;
  border: 1px solid #a3702e;
}

.cve-badge-low {
  background: rgba(255, 230, 90, 0.15);
  color: #ffe65a;
  border: 1px solid #a39a2e;
}

.cve-badge-unknown {
  background: rgba(150, 150, 150, 0.15);
  color: #aaa;
  border: 1px solid #555;
}

/* --- Terminal-style scan progress / log panel --- */

.terminal-panel {
  background: #060a08;
  border: 1px solid #2e7d5b;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 0 20px rgba(63, 174, 122, 0.15);
  font-family: "Courier New", Courier, monospace;
}

.terminal-header {
  display: flex;
  align-items: center;
  gap: 6px;
  background: #0d1512;
  padding: 8px 12px;
  border-bottom: 1px solid #1e2a1e;
}

.term-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  display: inline-block;
}
.term-dot-red { background: #ff5f56; }
.term-dot-yellow { background: #ffbd2e; }
.term-dot-green { background: #27c93f; }

.terminal-title {
  margin-left: 10px;
  color: #7fbf9f;
  font-size: 12px;
}

.terminal-progress-track {
  width: 100%;
  height: 4px;
  background: #0a0e14;
}

.terminal-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #2e7d5b, #3fae7a, #7fffb0);
  box-shadow: 0 0 8px rgba(127, 255, 176, 0.6);
  transition: width 0.3s ease;
}

.terminal-body {
  padding: 12px;
  max-height: 220px;
  overflow-y: auto;
  font-size: 12px;
  line-height: 1.5;
  background-image: repeating-linear-gradient(
    to bottom,
    rgba(63, 174, 122, 0.03),
    rgba(63, 174, 122, 0.03) 1px,
    transparent 1px,
    transparent 2px
  );
}

.terminal-line {
  color: #7fd7a0;
  white-space: pre-wrap;
  word-break: break-all;
}

.terminal-prompt {
  color: #3fae7a;
  font-weight: bold;
}

.terminal-cursor-line {
  color: #7fd7a0;
}

.blink-cursor {
  animation: blink 1s steps(1) infinite;
  color: #3fae7a;
}

@keyframes blink {
  0%, 50% { opacity: 1; }
  50.01%, 100% { opacity: 0; }
}

.terminal-body::-webkit-scrollbar,
.host-list::-webkit-scrollbar {
  width: 8px;
}
.terminal-body::-webkit-scrollbar-thumb,
.host-list::-webkit-scrollbar-thumb {
  background: #2e7d5b;
  border-radius: 4px;
}
.terminal-body::-webkit-scrollbar-track,
.host-list::-webkit-scrollbar-track {
  background: #0a0e14;
}
.summary-panel {
  flex: 1;
}

.summary-stat-row {
  display: flex;
  gap: 10px;
  margin-bottom: 18px;
}

.summary-stat {
  flex: 1;
  background: #141a14;
  border: 1px solid #1e2a1e;
  border-radius: 6px;
  padding: 12px 8px;
  text-align: center;
}

.summary-stat-value {
  color: #3fae7a;
  font-size: 24px;
  font-weight: 700;
  font-family: "Courier New", Courier, monospace;
}

.summary-stat-label {
  color: #7fbf9f;
  font-size: 11px;
  margin-top: 4px;
}

.summary-subheading {
  color: #3fae7a;
  font-size: 13px;
  margin: 16px 0 8px 0;
}

.severity-bars {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.severity-bar-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #141a14;
  padding: 6px 10px;
  border-radius: 4px;
}

.severity-count {
  color: #e0e0e0;
  font-family: "Courier New", Courier, monospace;
  font-weight: 700;
}

.service-list {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.service-row {
  display: flex;
  justify-content: space-between;
  padding: 6px 10px;
  background: #141a14;
  border-radius: 4px;
  font-size: 13px;
}

.service-name {
  color: #cfe;
  text-transform: capitalize;
}

.service-count {
  color: #3fae7a;
  font-family: "Courier New", Courier, monospace;
}

.cve-badge {
  cursor: pointer;
}

.cve-badge:hover {
  filter: brightness(1.3);
}

.exploit-btn {
  margin-top: 8px;
  padding: 5px 10px;
  background: #141a14;
  color: #ff9d5c;
  border: 1px solid #a35a2e;
  border-radius: 4px;
  cursor: pointer;
  font-size: 11.5px;
  font-family: inherit;
  width: 100%;
}

.exploit-btn:hover:not(:disabled) {
  background: #1e1410;
}

.exploit-btn:disabled {
  opacity: 0.6;
  cursor: default;
}

.exploit-results {
  margin-top: 8px;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.exploit-none {
  color: #666;
  font-size: 11.5px;
  margin: 4px 0 0 0;
}

.exploit-row {
  background: #1a1410;
  border: 1px solid #5a3a1e;
  border-radius: 4px;
  padding: 5px 8px;
  cursor: pointer;
  font-size: 11.5px;
}

.exploit-row:hover {
  background: #241a12;
}

.exploit-id {
  color: #ff9d5c;
  font-family: "Courier New", Courier, monospace;
  margin-right: 6px;
}

.exploit-title {
  color: #e0c0a0;
}

/* --- Rack-style grouped topology --- */

.rack-topology {
  position: relative;
  background: #0a0e14;
  background-image:
    linear-gradient(rgba(63,174,122,0.08) 1px, transparent 1px),
    linear-gradient(90deg, rgba(63,174,122,0.08) 1px, transparent 1px);
  background-size: 20px 20px;
  border: 1px solid #1e2a1e;
  border-radius: 8px;
  min-height: 500px;
  padding: 40px 24px 24px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.rack-lines-svg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
}

.rack-hub {
  width: 90px;
  height: 90px;
  border-radius: 50%;
  background: radial-gradient(circle, #c9a227, #8a6d1a);
  border: 2px solid #e0c34e;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 24px rgba(201, 162, 39, 0.4);
  margin-bottom: 32px;
  z-index: 2;
}

.rack-hub-label {
  color: #fff;
  font-weight: 700;
  font-size: 13px;
  text-align: center;
}

.rack-zones {
  display: flex;
  gap: 24px;
  flex-wrap: wrap;
  justify-content: center;
  width: 100%;
  z-index: 2;
}

.rack-zone {
  background: #0d1310;
  border-radius: 8px;
  padding: 14px;
  min-width: 220px;
  max-width: 280px;
}

.rack-zone-gateway {
  border: 1px solid #c9a227;
  box-shadow: 0 0 16px rgba(201, 162, 39, 0.15);
}

.rack-zone-self {
  border: 1px solid #5a7dc9;
  box-shadow: 0 0 16px rgba(90, 125, 201, 0.15);
}

.rack-zone-others {
  border: 1px solid #2e7d5b;
  box-shadow: 0 0 16px rgba(63, 174, 122, 0.15);
}

.rack-zone-title {
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  margin-bottom: 10px;
  color: #9fbfae;
}

.rack-zone-gateway .rack-zone-title { color: #e0c34e; }
.rack-zone-self .rack-zone-title { color: #7fa8ff; }
.rack-zone-others .rack-zone-title { color: #3fae7a; }

.rack-zone-chips {
  display: flex;
  flex-direction: column;
  gap: 6px;
  max-height: 320px;
  overflow-y: auto;
}

.rack-chip {
  background: #141a14;
  border: 1px solid #1e2a1e;
  border-left: 3px solid #2e7d5b;
  border-radius: 4px;
  padding: 8px 10px;
  cursor: pointer;
  transition: background 0.15s ease;
}

.rack-chip:hover {
  background: #1a221a;
}

.rack-chip-active {
  background: #1a221a;
  border-left: 3px solid #7fffb0;
}

.rack-chip-ip {
  color: #3fae7a;
  font-family: "Courier New", Courier, monospace;
  font-size: 13px;
  font-weight: 700;
}

.rack-chip-hostname {
  color: #9fbfae;
  font-size: 11.5px;
  margin-top: 1px;
}

.rack-chip-ports {
  color: #666;
  font-size: 11px;
  margin-top: 2px;
}

.view-toggle {
  display: flex;
  gap: 6px;
  margin-bottom: 12px;
}

.view-toggle-btn {
  padding: 6px 14px;
  background: #141a14;
  color: #7fbf9f;
  border: 1px solid #2e7d5b;
  border-radius: 4px;
  cursor: pointer;
  font-size: 12.5px;
  font-family: inherit;
}

.view-toggle-btn-active {
  background: #2e7d5b;
  color: #fff;
}

.dashboard {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.stat-card-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
}

.stat-card {
  background: #0d1310;
  border: 1px solid #2e7d5b;
  border-radius: 8px;
  padding: 16px 18px;
}

.stat-card-label {
  display: flex;
  align-items: center;
  gap: 6px;
  color: #7fbf9f;
  font-size: 11px;
  letter-spacing: 0.5px;
  text-transform: uppercase;
  margin-bottom: 8px;
}

.stat-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  display: inline-block;
}
.stat-dot-green { background: #3fae7a; }
.stat-dot-teal { background: #4dbdbd; }
.stat-dot-orange { background: #ff9d5c; }
.stat-dot-gray { background: #999; }

.stat-card-value {
  color: #fff;
  font-size: 32px;
  font-weight: 700;
  font-family: "Courier New", Courier, monospace;
  margin-bottom: 8px;
}

.stat-card-bar {
  height: 3px;
  background: #141a14;
  border-radius: 2px;
  overflow: hidden;
}

.stat-card-bar-fill {
  height: 100%;
  transition: width 0.4s ease;
}

.chart-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.chart-panel {
  min-height: 240px;
}

.legend-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.legend-row {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12.5px;
  color: #cfe;
}

.legend-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  display: inline-block;
}

.table-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
  flex-wrap: wrap;
  gap: 10px;
}

.table-filter-input {
  padding: 6px 10px;
  background: #141a14;
  color: #fff;
  border: 1px solid #2e7d5b;
  border-radius: 4px;
  font-size: 13px;
  min-width: 200px;
}

.dashboard-table-wrap {
  overflow-x: auto;
  max-height: 420px;
  overflow-y: auto;
}

.dashboard-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 13px;
}

.dashboard-table thead th {
  text-align: left;
  padding: 8px 10px;
  color: #7fbf9f;
  border-bottom: 1px solid #2e7d5b;
  position: sticky;
  top: 0;
  background: #0d1310;
  font-size: 11.5px;
  text-transform: uppercase;
  letter-spacing: 0.4px;
}

.dashboard-table tbody td {
  padding: 8px 10px;
  border-bottom: 1px solid #1e2a1e;
  vertical-align: top;
}

.dashboard-table tbody tr:hover {
  background: #10160f;
}

.mono {
  font-family: "Courier New", Courier, monospace;
  color: #9fbfae;
}

.dim {
  color: #666;
}

.table-state-badge {
  background: rgba(63, 174, 122, 0.15);
  color: #3fae7a;
  border: 1px solid #2e7d5b;
  border-radius: 3px;
  padding: 2px 6px;
  font-size: 11px;
  text-transform: uppercase;
}

.table-badge-list {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  max-width: 220px;
}

.table-mini-btn {
  padding: 3px 8px;
  background: #141a14;
  color: #ff9d5c;
  border: 1px solid #a35a2e;
  border-radius: 3px;
  cursor: pointer;
  font-size: 11px;
}

.table-mini-btn:disabled {
  opacity: 0.6;
  cursor: default;
}

.exploit-mini-badge {
  display: inline-block;
  padding: 2px 6px;
  border-radius: 3px;
  font-size: 10.5px;
  font-family: "Courier New", Courier, monospace;
  background: rgba(255, 157, 92, 0.12);
  color: #ff9d5c;
  border: 1px solid #a35a2e;
  cursor: pointer;
}

.exploit-mini-badge:hover {
  filter: brightness(1.3);
}

.app-layout {
  display: flex;
  min-height: 100vh;
  background: #0a0e14;
  color: #e0e0e0;
  font-family: "Inter", "Segoe UI", sans-serif;
}

.sidebar {
  width: 220px;
  flex-shrink: 0;
  background: #0d1310;
  border-right: 1px solid #1e2a1e;
  padding: 20px 0;
  display: flex;
  flex-direction: column;
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 20px 20px 20px;
  border-bottom: 1px solid #1e2a1e;
  margin-bottom: 12px;
}

.sidebar-brand-icon {
  color: #3fae7a;
  font-size: 18px;
}

.sidebar-brand-text {
  color: #3fae7a;
  font-weight: 700;
  font-size: 16px;
  letter-spacing: 0.3px;
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 0 10px;
}

.sidebar-nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: transparent;
  border: none;
  border-radius: 6px;
  color: #9fbfae;
  font-size: 13.5px;
  text-align: left;
  cursor: pointer;
  font-family: inherit;
}

.sidebar-nav-item:hover:not(.sidebar-nav-item-disabled) {
  background: #141a14;
  color: #cfe;
}

.sidebar-nav-item-active {
  background: #16241a;
  color: #3fae7a;
  font-weight: 600;
}

.sidebar-nav-item-disabled {
  opacity: 0.4;
  cursor: default;
}

.sidebar-nav-icon {
  font-size: 15px;
  width: 18px;
  text-align: center;
}

.sidebar-nav-soon {
  margin-left: auto;
  font-size: 9.5px;
  background: #1e2a1e;
  color: #666;
  padding: 1px 6px;
  border-radius: 10px;
  text-transform: uppercase;
}

.app-content {
  flex: 1;
  padding: 28px 32px;
  overflow-y: auto;
}

.page-header {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  margin-bottom: 20px;
}

.page-header-icon {
  width: 36px;
  height: 36px;
  background: #16241a;
  border: 1px solid #2e7d5b;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: #3fae7a;
  flex-shrink: 0;
}

.page-title {
  color: #fff;
  margin: 0;
  font-size: 22px;
}

.page-subtitle {
  color: #7fbf9f;
  margin: 4px 0 0 0;
  font-size: 13px;
}

.sidebar {
  width: 260px;
  flex-shrink: 0;
  background: #0a0e14;
  padding: 18px 0;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 18px 16px 18px;
  margin-bottom: 10px;
}

.sidebar-brand-icon {
  color: #3fae7a;
  font-size: 17px;
}

.sidebar-brand-text {
  color: #fff;
  font-weight: 700;
  font-size: 15px;
}

.sidebar-brand-tag {
  color: #3fae7a;
  font-size: 9px;
  letter-spacing: 0.5px;
  margin-left: auto;
  opacity: 0.7;
}

.sidebar-top-nav {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 0 10px;
  margin-bottom: 12px;
}

.sidebar-search {
  display: flex;
  align-items: center;
  gap: 6px;
  margin: 0 14px 14px 14px;
  padding: 7px 10px;
  background: #141a14;
  border: 1px solid #2e7d5b;
  border-radius: 6px;
}

.sidebar-search-icon {
  color: #666;
  font-size: 12px;
}

.sidebar-search-input {
  flex: 1;
  background: transparent;
  border: none;
  outline: none;
  color: #cfe;
  font-size: 12.5px;
  font-family: inherit;
}

.sidebar-categories {
  display: flex;
  flex-direction: column;
  gap: 2px;
  padding: 0 10px;
  flex: 1;
}

.sidebar-category-header {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  padding: 9px 12px;
  background: transparent;
  border: none;
  border-radius: 6px;
  color: #9fbfae;
  font-size: 13px;
  text-align: left;
  cursor: pointer;
  font-family: inherit;
}

.sidebar-category-header:hover {
  background: #141a14;
  color: #cfe;
}

.sidebar-category-label {
  flex: 1;
}

.sidebar-category-count {
  color: #3fae7a;
  font-size: 11.5px;
  font-family: "Courier New", Courier, monospace;
  opacity: 0.7;
}

.sidebar-category-chevron {
  color: #666;
  font-size: 13px;
  transition: transform 0.15s ease;
}

.sidebar-category-chevron-open {
  transform: rotate(90deg);
}

.sidebar-subitems {
  display: flex;
  flex-direction: column;
  gap: 1px;
  padding-left: 30px;
  margin-top: 2px;
  margin-bottom: 4px;
}

.sidebar-subitem {
  display: flex;
  align-items: center;
  padding: 7px 10px;
  background: transparent;
  border: none;
  border-radius: 5px;
  color: #7fbf9f;
  font-size: 12.5px;
  text-align: left;
  cursor: pointer;
  font-family: inherit;
}

.sidebar-subitem:hover:not(.sidebar-nav-item-disabled) {
  background: #141a14;
  color: #cfe;
}

.sidebar-subitem-active {
  background: #16241a;
  color: #3fae7a;
  font-weight: 600;
}

.sidebar-footer {
  padding: 12px 18px 0 18px;
  margin-top: 12px;
  color: #555;
  font-size: 11px;
}

.app-root {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #0a0e14;
}

.titlebar {
  height: 36px;
  flex-shrink: 0;
  background: #0a0e14;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4px 0 14px;
  user-select: none;
}

.titlebar-left {
  display: flex;
  align-items: center;
  gap: 7px;
}

.titlebar-icon {
  color: #3fae7a;
  font-size: 13px;
}

.titlebar-label {
  color: #7fbf9f;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: 0.3px;
}

.titlebar-controls {
  display: flex;
  align-items: center;
  height: 100%;
}

.titlebar-btn {
  width: 44px;
  height: 36px;
  background: transparent;
  border: none;
  color: #7fbf9f;
  font-size: 13px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.titlebar-btn:hover {
  background: #16241a;
  color: #3fae7a;
}

.titlebar-btn-close:hover {
  background: #8b2f2f;
  color: #fff;
}

.app-layout {
  display: flex;
  flex: 1;
  min-height: 0;
  background: #0a0e14;
  color: #e0e0e0;
  font-family: "Inter", "Segoe UI", sans-serif;
}